@model CarInfoManagementSystem.Models.Manufacturer

@{
    ViewData["Title"] = "Add New Manufacturer";
    var returnUrl = ViewBag.ReturnUrl;
}

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Add New Manufacturer</h5>
    </div>
    <form asp-action="Create" asp-route-returnUrl="@returnUrl">
        <div class="modal-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Manufacturer Name" />
                <label asp-for="Name">Manufacturer Name</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Add Manufacturer</button>
            @if (string.IsNullOrEmpty(returnUrl))
            {
                <a asp-controller="Car" asp-action="Create" class="btn btn-outline-secondary">Cancel</a>
            }
            else
            {
                <a href="@returnUrl" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}