<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Info Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preload" as="image" href="/images/no-image.png" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .image-loading {
            position: relative;
            background: linear-gradient(110deg, #1e293b 8%, #334155 18%, #1e293b 33%);
            background-size: 200% 100%;
            animation: shineEffect 1.5s linear infinite;
            min-height: 200px;
            border-radius: 16px;
            overflow: hidden;
        }

        @@keyframes shineEffect {
            to { background-position-x: -200%; }
        }

        .image-wrapper {
            position: relative;
            overflow: hidden;
        }

        .blur-load {
            width: 100%;
            aspect-ratio: 16/9;
        }

        .blur-load.loaded > .image-loading {
            display: none;
        }

        .image-loading::after {
            content: '';
            position: absolute;
            inset: 0;
            transform: translateX(-100%);
            background-image: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0,
                rgba(255, 255, 255, 0.05) 20%,
                rgba(255, 255, 255, 0.1) 60%,
                rgba(255, 255, 255, 0)
            );
            animation: shimmerEffect 2s infinite;
        }

        @@keyframes shimmerEffect {
            100% { transform: translateX(100%); }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark fixed-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-car-front-fill me-2 fs-4"></i>
                    <span class="fw-bold">CIMS</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-2">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-2"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded" asp-controller="Car" asp-action="Index">
                                <i class="bi bi-car-front me-2"></i>Cars
                            </a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded" asp-controller="Car" asp-action="Create">
                                    <i class="bi bi-plus-circle me-2"></i>Add Car
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-2"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light d-flex align-items-center" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login
                            </a>
                            <a class="btn btn-primary d-flex align-items-center" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-2"></i>Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3" style="margin-top: 4rem;">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3">
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between align-items-center">
                <span>&copy; @DateTime.Now.Year - Car Info Management System</span>
                <a class="text-reset text-decoration-none" asp-controller="Home" asp-action="Privacy">
                    Privacy Policy
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        AOS.init({
            duration: 800,
            easing: 'ease-out-cubic',
            once: true
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
