@model CarInfoManagementSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .auth-wrapper {
        min-height: calc(100vh - 60px);
        background: linear-gradient(135deg, var(--dark-surface) 0%, var(--dark-bg) 100%);
        position: relative;
        overflow: hidden;
    }

    .auth-wrapper::before {
        content: '';
        position: absolute;
        width: 1000px;
        height: 1000px;
        border-radius: 50%;
        background: linear-gradient(45deg, var(--secondary-color) 0%, var(--primary-dark) 100%);
        filter: blur(80px);
        opacity: 0.15;
        top: -400px;
        left: -400px;
        z-index: 0;
    }

    .auth-wrapper::after {
        content: '';
        position: absolute;
        width: 800px;
        height: 800px;
        border-radius: 50%;
        background: linear-gradient(45deg, var(--primary-color) 0%, var(--accent-color) 100%);
        filter: blur(80px);
        opacity: 0.1;
        bottom: -300px;
        right: -300px;
        z-index: 0;
    }

    .auth-container {
        position: relative;
        z-index: 1;
    }

    .auth-card {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-control:not(:placeholder-shown) {
        background: var(--dark-surface);
    }
</style>

<div class="auth-wrapper">
    <div class="container-fluid px-4">
        <div class="row justify-content-center min-vh-75 align-items-center auth-container">
            <div class="col-md-5" data-aos="fade-up">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus text-premium display-1"></i>
                    <h1 class="text-premium mt-3">Create Account</h1>
                    <p class="text-secondary">Join our exclusive luxury vehicle platform</p>
                </div>

                <div class="auth-card">
                    <div class="card-body p-4">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger fade show"></div>
                            <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />

                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                                <label asp-for="Email">Email Address</label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Password" class="form-control" placeholder="Password" />
                                <label asp-for="Password">Password</label>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                                <label asp-for="ConfirmPassword">Confirm Password</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-person-plus me-2"></i> Create Account
                                </button>
                                <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-primary">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In Instead
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="text-secondary">
                        By registering, you agree to our
                        <a href="#" class="text-premium">Terms of Service</a> and
                        <a href="#" class="text-premium">Privacy Policy</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.form-floating input').forEach(element => {
            if (element.value) {
                element.parentElement.classList.add('focused');
            }
            element.addEventListener('focus', () => {
                element.parentElement.classList.add('focused');
            });
            element.addEventListener('blur', () => {
                if (!element.value) {
                    element.parentElement.classList.remove('focused');
                }
            });
        });
    </script>
}