@{
    ViewData["Title"] = "Welcome to CIMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="hero-section">
    <div class="hero-content">
        <h1 class="display-1 fw-bold mb-4" data-aos="fade-up">
            Discover Your 
            <span class="text-gradient">Perfect</span> 
            Drive
        </h1>
        <p class="lead mb-5" data-aos="fade-up" data-aos-delay="200">
            Explore our extensive collection of premium vehicles, 
            from luxurious sedans to powerful SUVs.
        </p>
        <div class="d-flex gap-3" data-aos="fade-up" data-aos-delay="400">
            <a asp-controller="Car" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-car-front me-2"></i>Browse Cars
            </a>
            <a href="#features" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-arrow-down me-2"></i>Learn More
            </a>
        </div>
    </div>
    <div class="hero-carousel" data-aos="fade-left" data-aos-delay="300">
        <div class="carousel-item active">
            <img src="~/media/home/hero-1.jpg" alt="Luxury Car" />
        </div>
    </div>
</div>

<section id="features" class="py-5">
    <div class="container-fluid px-4">
        <div class="row g-4">
            <div class="col-lg-4" data-aos="fade-up">
                <div class="feature-card">
                    <div class="icon-wrapper">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3>Premium Selection</h3>
                    <p>Carefully curated collection of high-quality vehicles from trusted manufacturers.</p>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card">
                    <div class="icon-wrapper">
                        <i class="bi bi-gear"></i>
                    </div>
                    <h3>Expert Details</h3>
                    <p>Comprehensive technical specifications and features for every vehicle.</p>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="400">
                <div class="feature-card">
                    <div class="icon-wrapper">
                        <i class="bi bi-graph-up"></i>
                    </div>
                    <h3>Market Insights</h3>
                    <p>Stay informed with up-to-date pricing and market trends.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="featured-cars py-5">
    <div class="container-fluid px-4">
        <h2 class="display-5 mb-5" data-aos="fade-up">Featured Vehicles</h2>
        <div class="featured-grid">
            <div class="featured-car large" data-aos="zoom-in">
                <img src="~/media/home/featured-1.jpg" alt="Luxury Sedan" />
                <div class="overlay">
                    <h3>Luxury Sedans</h3>
                    <a asp-controller="Car" asp-action="Index" class="btn btn-outline-light">Explore</a>
                </div>
            </div>
            <div class="featured-car" data-aos="zoom-in" data-aos-delay="200">
                <img src="~/media/home/featured-2.jpg" alt="Premium SUV" />
                <div class="overlay">
                    <h3>Premium SUVs</h3>
                    <a asp-controller="Car" asp-action="Index" class="btn btn-outline-light">Explore</a>
                </div>
            </div>
            <div class="featured-car" data-aos="zoom-in" data-aos-delay="400">
                <img src="~/media/home/featured-3.jpg" alt="Sports Car" />
                <div class="overlay">
                    <h3>Sports Cars</h3>
                    <a asp-controller="Car" asp-action="Index" class="btn btn-outline-light">Explore</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section py-5" data-aos="fade-up">
    <div class="container-fluid px-4">
        <div class="cta-content text-center">
            <h2 class="display-4 mb-4">Ready to Find Your Dream Car?</h2>
            <p class="lead mb-4">Browse our extensive collection of premium vehicles today.</p>
            <a asp-controller="Car" asp-action="Index" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-car-front me-2"></i>View All Cars
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Parallax effect for hero section
            window.addEventListener('scroll', function() {
                const scrolled = window.pageYOffset;
                const hero = document.querySelector('.hero-section');
                if (hero) {
                    hero.style.backgroundPositionY = -(scrolled * 0.5) + 'px';
                }
            });
        });
    </script>
}
