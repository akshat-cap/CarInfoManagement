@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = $"{Model.Manufacturer?.Name} {Model.Model}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/car-details.css" />
    <style>
        .car-details-hero {
            position: relative;
            height: 60vh;
            min-height: 500px;
            margin-bottom: 2rem;
            border-radius: 1rem;
            overflow: hidden;
            background-color: #f0f0f0;
        }

        .image-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .image-wrapper.loaded {
            opacity: 1;
        }

        .image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .overlay-gradient {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 70%;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
            z-index: 1;
        }

        .car-details-content {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 2rem;
            color: white;
            z-index: 2;
        }

        .text-dark {
            color: #f8f9fa !important;
        }

        .spec-box {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 1.5rem;
            border-radius: 0.5rem;
            backdrop-filter: blur(10px);
        }

        .spec-box h6 {
            color: #f8f9fa;
            font-weight: 500;
        }

        .spec-box p {
            color: #e9ecef;
        }

        .safety-feature h6 {
            color: #f8f9fa;
        }

        .safety-feature p {
            color: #e9ecef;
        }

        .card {
            background-color: rgba(33, 37, 41, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card-title {
            color: #f8f9fa;
        }
    </style>
}

<div class="container-fluid px-4">
    <div class="car-details-hero" data-aos="fade">
        <div class="image-wrapper">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="/cars/@Model.PhotoUrl" 
                     alt="@Model.Model" 
                     crossorigin="anonymous"
                     loading="eager"
                     onload="this.parentElement.classList.add('loaded')"
                     onerror="this.onerror=null; this.src='/images/no-image.png'; this.parentElement.classList.add('loaded')" />
            }
        </div>
        <div class="overlay-gradient"></div>
        <div class="car-details-content">
            <div class="row align-items-end">
                <div class="col-lg-8" data-aos="fade-right">
                    <div class="mb-4">
                        <h1 class="display-4 mb-2">@Model.Manufacturer?.Name @Model.Model</h1>
                        <div class="d-flex flex-wrap gap-3">
                            <span class="badge bg-primary px-4 py-2">
                                <i class="bi bi-currency-rupee me-1"></i> @Model.Price.ToString("N0")
                            </span>
                            <span class="badge bg-secondary px-4 py-2">
                                <i class="bi bi-tag-fill me-1"></i> @Model.CarType?.Type
                            </span>
                        </div>
                    </div>
                </div>
                @if (User.IsInRole("Administrator"))
                {
                    <div class="col-lg-4 text-lg-end" data-aos="fade-left">
                        <div class="d-flex gap-2 justify-content-lg-end">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">
                                <i class="bi bi-pencil me-2"></i>Edit Car
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-lg">
                                <i class="bi bi-trash me-2"></i>Delete
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8" data-aos="fade-up">
            <div class="card h-100">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">Technical Specifications</h4>
                    <div class="row g-4">
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-gear-fill" style="font-size: 2rem; color: #007bff;"></i>
                                <h6 class="mt-3 mb-2">Engine</h6>
                                <p class="mb-0 fs-5">@Model.Engine</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-speedometer2" style="font-size: 2rem; color: #28a745;"></i>
                                <h6 class="mt-3 mb-2">Power Output</h6>
                                <p class="mb-0 fs-5">@Model.BHP BHP</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-gear-wide" style="font-size: 2rem; color: #ffc107;"></i>
                                <h6 class="mt-3 mb-2">Transmission</h6>
                                <p class="mb-0 fs-5">@Model.TransmissionType?.Name</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-fuel-pump-fill" style="font-size: 2rem; color: #17a2b8;"></i>
                                <h6 class="mt-3 mb-2">Mileage</h6>
                                <p class="mb-0 fs-5">@Model.Mileage km/l</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-people" style="font-size: 2rem; color: #6f42c1;"></i>
                                <h6 class="mt-3 mb-2">Seating</h6>
                                <p class="mb-0 fs-5">@Model.Seat seats</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="spec-box text-center">
                                <i class="bi bi-box" style="font-size: 2rem; color: #dc3545;"></i>
                                <h6 class="mt-3 mb-2">Boot Space</h6>
                                <p class="mb-0 fs-5">@Model.BootSpace litres</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card h-100">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">Safety & Features</h4>
                    
                    <div class="safety-feature">
                        <h6 class="text-primary d-flex align-items-center mb-3">
                            <i class="bi bi-shield-check me-2"></i>
                            Air Bag Configuration
                        </h6>
                        <p class="mb-4 ps-4">@Model.AirBagDetails</p>
                        
                        <h6 class="text-primary d-flex align-items-center mb-3">
                            <i class="bi bi-star-fill me-2"></i>
                            Premium Features
                        </h6>
                        <p class="mb-0 ps-4">@Model.Features</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4" data-aos="fade-up">
        <a asp-action="Index" class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Inventory
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const image = document.querySelector('.image-wrapper img');
            if (image) {
                if (image.complete) {
                    image.parentElement.classList.add('loaded');
                }
                
                image.onload = () => {
                    image.parentElement.classList.add('loaded');
                };
                
                image.onerror = () => {
                    image.src = '/images/no-image.png';
                    image.parentElement.classList.add('loaded');
                };
            }
        });
    </script>
}
