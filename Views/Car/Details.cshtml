@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Car Details";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-6">
            <img src="@Url.Content(Model.PhotoUrl)" alt="@Model.Model" class="img-fluid" onerror="this.onerror=null; this.src='/images/no-image.png'; this.classList.add('fallback-image');" />
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title mb-4">@Model.Model</h2>
                    <div class="specs-grid">
                        <div class="spec-item">
                            <i class="bi bi-building"></i>
                            <strong>Manufacturer:</strong>
                            <span>@Model.Manufacturer.Name</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-tag"></i>
                            <strong>Type:</strong>
                            <span>@Model.CarType.Type</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-gear"></i>
                            <strong>Engine:</strong>
                            <span>@Model.Engine</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-speedometer2"></i>
                            <strong>BHP:</strong>
                            <span>@Model.BHP</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-gear-wide"></i>
                            <strong>Transmission:</strong>
                            <span>@Model.TransmissionType.Name</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-fuel-pump"></i>
                            <strong>Mileage:</strong>
                            <span>@Model.Mileage km/l</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-people"></i>
                            <strong>Seats:</strong>
                            <span>@Model.Seat</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-box"></i>
                            <strong>Boot Space:</strong>
                            <span>@Model.BootSpace L</span>
                        </div>
                        <div class="spec-item">
                            <i class="bi bi-currency-dollar"></i>
                            <strong>Price:</strong>
                            <span class="text-primary fw-bold">₹@Model.Price.ToString("N0")</span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h5><i class="bi bi-shield-check"></i> Safety Features</h5>
                        <p>@Model.AirBagDetails</p>
                    </div>

                    <div class="mt-4">
                        <h5><i class="bi bi-star"></i> Additional Features</h5>
                        <p>@Model.Features</p>
                    </div>

                    <div class="mt-4">
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.spec-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    align-items: center;
}

.spec-item i {
    grid-row: 1 / 3;
    font-size: 1.5rem;
    color: #0d6efd;
    margin-right: 0.5rem;
}

.spec-item strong {
    font-size: 0.875rem;
    color: #6c757d;
}

.spec-item span {
    font-size: 1rem;
}
</style>