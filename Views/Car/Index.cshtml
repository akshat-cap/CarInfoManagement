@model IEnumerable<CarInfoManagementSystem.Models.Car>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Cars";
}

@section Styles {
    <style>
        .small-blur-load {
            height: 240px;
        }
        .car-image-container {
            position: relative;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            aspect-ratio: 16/9;
            background-color: #f0f0f0;
        }
        .car-image-container.loaded {
            opacity: 1;
        }
        .car-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .card {
            background-color: rgba(33, 37, 41, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .card-title {
            color: #f8f9fa;
        }
        .text-medium-emphasis {
            color: #e9ecef !important;
        }
        .car-info {
            padding: 1.5rem;
            color: #f8f9fa;
        }
        .spec-item {
            color: #e9ecef;
            margin-right: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .input-group .form-control {
            background-color: rgba(255, 255, 255, 0.1);
            border: none;
            color: #f8f9fa;
        }
        .input-group .form-control::placeholder {
            color: #adb5bd;
        }
        .input-group-text {
            background-color: transparent;
            border: none;
            color: #adb5bd;
        }
        .form-select {
            background-color: rgba(255, 255, 255, 0.1);
            border: none;
            color: #f8f9fa;
        }
        .form-select option {
            background-color: #212529;
            color: #f8f9fa;
        }
    </style>
}

<div class="container-fluid px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1 text-light">Available Cars</h2>
                    <p class="text-medium-emphasis mb-0">Browse and manage vehicle inventory</p>
                </div>
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Add New Car
                    </a>
                }
            </div>

            <div class="filter-section">
                <div class="row g-4">
                    <div class="col-lg-5 col-md-12">
                        <form asp-action="Search" method="get" class="search-form h-100">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" name="searchName" class="form-control" 
                                       placeholder="Search by model, manufacturer, or type..." />
                            </div>
                        </form>
                    </div>
                    <div class="col-lg-7 col-md-12">
                        <form asp-action="FilterByManufacturerAndType" method="get">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <select name="manufacturerId" class="form-select" asp-items="ViewBag.Manufacturers">
                                        <option value="">All Manufacturers</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select name="typeId" class="form-select" asp-items="ViewBag.CarTypes">
                                        <option value="">All Types</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-funnel me-2"></i>Filter
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-md-6 col-lg-4" data-aos="fade-up">
                <div class="card h-100 shadow-sm">
                    <div class="car-image-container">
                        @if (!string.IsNullOrEmpty(car.PhotoUrl))
                        {
                            <img src="/cars/@(car.PhotoUrl)"
                                 alt="@(car.Model)"
                                 class="car-image"
                                 crossorigin="anonymous"
                                 loading="eager"
                                 onload="this.parentElement.classList.add('loaded')"
                                 onerror="this.onerror=null; this.src='/images/no-image.png'; this.parentElement.classList.add('loaded')" />
                        }
                    </div>
                    <div class="car-info">
                        <h5 class="card-title mb-3">@(car.Manufacturer?.Name) @(car.Model)</h5>
                        <div class="car-specs mb-4">
                            <span class="spec-item">
                                <i class="bi bi-gear"></i> @(car.TransmissionType?.Name)
                            </span>
                            <span class="spec-item">
                                <i class="bi bi-car-front"></i> @(car.CarType?.Type)
                            </span>
                            <span class="spec-item">
                                <i class="bi bi-speedometer2"></i> @(car.BHP) BHP
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@(car.Id)" class="btn btn-primary">
                                <i class="bi bi-info-circle me-2"></i>Details
                            </a>
                            @if (User.IsInRole("Administrator"))
                            {
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@(car.Id)" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@(car.Id)" class="btn btn-outline-primary">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="card glass p-5">
                <div class="card-body">
                    <i class="bi bi-car-front display-1 text-medium-emphasis mb-3"></i>
                    <h3 class="text-light">No cars found</h3>
                    <p class="text-medium-emphasis">No vehicles match your search criteria.</p>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle me-2"></i>Add New Car
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Preserve filter selections
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("manufacturerId")) {
                document.querySelector("select[name='manufacturerId']").value = urlParams.get("manufacturerId");
            }
            if (urlParams.has("typeId")) {
                document.querySelector("select[name='typeId']").value = urlParams.get("typeId");
            }

            // Preload images
            const images = document.querySelectorAll('.car-image');
            images.forEach(img => {
                if (img.complete) {
                    img.parentElement.classList.add('loaded');
                }
                
                const preloadImg = new Image();
                preloadImg.onload = () => {
                    img.src = preloadImg.src;
                    img.parentElement.classList.add('loaded');
                };
                preloadImg.src = img.src;
            });
        });
    </script>
}