@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Add New Car";
}

<div class="container py-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Car</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="form-group">
                            <label asp-for="PhotoFile" class="form-label">Car Photo</label>
                            <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="PhotoFile" class="text-danger"></span>
                            <img id="photoPreview" src="#" alt="Image Preview" class="img-thumbnail mt-2 photo-preview" style="display:none; max-height: 200px;" onerror="this.onerror=null; this.src='/images/no-image.png'; this.classList.add('fallback-image');" />
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Model" class="form-control" placeholder="Model" />
                                    <label asp-for="Model"></label>
                                    <span asp-validation-for="Model" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ManufacturerId" class="form-select" asp-items="ViewBag.Manufacturers">
                                        <option value="">Select Manufacturer</option>
                                    </select>
                                    <label asp-for="ManufacturerId"></label>
                                </div>
                                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
                                <div class="mt-2" id="addManufacturerSection">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="showManufacturerInput()">
                                        <i class="bi bi-plus-circle"></i> Add New Manufacturer
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="TypeId" class="form-select" asp-items="ViewBag.CarTypes">
                                        <option value="">Select Car Type</option>
                                    </select>
                                    <label asp-for="TypeId"></label>
                                    <span asp-validation-for="TypeId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="TransmissionId" class="form-select" asp-items="ViewBag.TransmissionTypes">
                                        <option value="">Select Transmission</option>
                                    </select>
                                    <label asp-for="TransmissionId"></label>
                                    <span asp-validation-for="TransmissionId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Engine" class="form-control" placeholder="Engine" />
                                    <label asp-for="Engine"></label>
                                    <span asp-validation-for="Engine" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="BHP" class="form-control" placeholder="BHP" />
                                    <label asp-for="BHP"></label>
                                    <span asp-validation-for="BHP" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Mileage" class="form-control" placeholder="Mileage" />
                                    <label asp-for="Mileage"></label>
                                    <span asp-validation-for="Mileage" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Seat" class="form-control" placeholder="Seats" />
                                    <label asp-for="Seat"></label>
                                    <span asp-validation-for="Seat" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="BootSpace" class="form-control" placeholder="Boot Space" />
                                    <label asp-for="BootSpace"></label>
                                    <span asp-validation-for="BootSpace" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Price" class="form-control" placeholder="Price" />
                                    <label asp-for="Price"></label>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="AirBagDetails" class="form-control" placeholder="Air Bag Details" />
                                    <label asp-for="AirBagDetails"></label>
                                    <span asp-validation-for="AirBagDetails" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Features" class="form-control" placeholder="Features" style="height: 100px"></textarea>
                                    <label asp-for="Features"></label>
                                    <span asp-validation-for="Features" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create Car
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quick Add Manufacturer Modal -->
<div class="modal fade" id="quickAddManufacturerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Manufacturer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="manufacturerName" placeholder="Manufacturer Name">
                    <label for="manufacturerName">Manufacturer Name</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveManufacturer()">Add</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Check if there's an error message in TempData and show it as a Toastr notification
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    toastr.error('@TempData["ErrorMessage"]');
            </text>
        }

        function showManufacturerInput() {
            var modal = new bootstrap.Modal(document.getElementById('quickAddManufacturerModal'));
            modal.show();
        }

        function saveManufacturer() {
            var name = document.getElementById('manufacturerName').value;
            if (!name) {
                alert('Please enter a manufacturer name');
                return;
            }

            fetch('/Manufacturer/QuickAdd', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ name: name })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    var select = document.getElementById('ManufacturerId');
                    var option = new Option(name, data.id);
                    select.add(option);
                    select.value = data.id;
                    bootstrap.Modal.getInstance(document.getElementById('quickAddManufacturerModal')).hide();
                    document.getElementById('manufacturerName').value = '';
                } else {
                    alert(data.message || 'Error adding manufacturer');
                }
            })
            .catch(error => {
                alert('Error adding manufacturer');
            });
        }

        document.getElementById('PhotoFile').addEventListener('change', function() {
            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('photoPreview').src = e.target.result;
                    document.getElementById('photoPreview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                document.getElementById('photoPreview').style.display = 'none';
            }
        });
    </script>
}
