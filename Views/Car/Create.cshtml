@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Add New Luxury Vehicle";
}

<div class="container-fluid px-4">
    <div class="row mb-4" data-aos="fade-up">
        <div class="col-12">
            <h1 class="display-4 text-light">Add New Luxury Vehicle</h1>
        </div>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" id="createCarForm">
        <div class="row">
            <div class="col-md-8" data-aos="fade-right">
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-light"><i class="bi bi-info-circle"></i> Basic Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input asp-for="Model" class="form-control" placeholder="Model Name">
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <select asp-for="ManufacturerId" class="form-select" asp-items="ViewBag.Manufacturers">
                                    <option value="">Select Manufacturer</option>
                                </select>
                                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
                                <div class="mt-2" id="addManufacturerSection">
                                    <button type="button" class="btn btn-sm btn-outline-light" onclick="showManufacturerInput()">
                                        <i class="bi bi-plus-circle"></i> New Manufacturer
                                    </button>
                                    <div id="newManufacturerInput" class="mt-2" style="display: none;">
                                        <input type="text" id="newManufacturerName" class="form-control" placeholder="Enter Manufacturer Name" />
                                        <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addNewManufacturer()">Add</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <select asp-for="TypeId" class="form-select" asp-items="ViewBag.CarTypes">
                                    <option value="">Select Vehicle Type</option>
                                </select>
                                <span asp-validation-for="TypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <select asp-for="TransmissionId" class="form-select" asp-items="ViewBag.TransmissionTypes">
                                    <option value="">Select Transmission Type</option>
                                </select>
                                <span asp-validation-for="TransmissionId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="card-header">
                        <h4 class="mb-0 text-light"><i class="bi bi-gear"></i> Technical Specifications</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input asp-for="Engine" class="form-control" placeholder="Engine Specifications">
                                <span asp-validation-for="Engine" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <input asp-for="BHP" class="form-control" placeholder="BHP">
                                <span asp-validation-for="BHP" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <input asp-for="Mileage" class="form-control" placeholder="Mileage (km/l)">
                                <span asp-validation-for="Mileage" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <input asp-for="Price" class="form-control" placeholder="Price">
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="card-header">
                        <h4 class="mb-0 text-light"><i class="bi bi-shield-check"></i> Safety & Features</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input asp-for="Seat" class="form-control" placeholder="Number of Seats">
                                <span asp-validation-for="Seat" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <input asp-for="BootSpace" class="form-control" placeholder="Boot Space (litres)">
                                <span asp-validation-for="BootSpace" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <input asp-for="AirBagDetails" class="form-control" placeholder="Air Bag Configuration">
                                <span asp-validation-for="AirBagDetails" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <textarea asp-for="Features" class="form-control" placeholder="Additional Features" rows="3"></textarea>
                                <span asp-validation-for="Features" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-left">
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-light"><i class="bi bi-image"></i> Vehicle Image</h4>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <img id="photoPreview" src="/images/no-image.png" class="img-fluid rounded mb-3" alt="Vehicle Preview">
                        </div>
                        <div class="form-group">
                            <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="PhotoFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Add Vehicle
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .card {
        background-color: rgba(33, 37, 41, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .form-control, .form-select {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f8f9fa;
    }
    .form-control::placeholder {
        color: #adb5bd;
    }
    .form-select {
        color: #f8f9fa;
    }
    .form-select option {
        background-color: #212529;
        color: #f8f9fa;
    }
    .card-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('photoPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function showManufacturerInput() {
            document.getElementById('newManufacturerInput').style.display = 'block';
        }

        async function addNewManufacturer() {
            const name = document.getElementById('newManufacturerName').value;
            if (!name) {
                alert('Please enter a manufacturer name.');
                return;
            }

            const response = await fetch('/Manufacturer/QuickAdd', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ Name: name })
            });

            const result = await response.json();
            if (result.success) {
                const select = document.querySelector('select[name="ManufacturerId"]');
                const option = document.createElement('option');
                option.value = result.id;
                option.text = result.name;
                option.selected = true;
                select.appendChild(option);
                document.getElementById('newManufacturerInput').style.display = 'none';
                document.getElementById('newManufacturerName').value = '';
            } else {
                alert(result.message);
            }
        }
    </script>
}
