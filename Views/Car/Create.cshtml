@model Car

@{
    ViewData["Title"] = "Add New Luxury Vehicle";
}

<div class="container-fluid px-4">
    <div class="row mb-4" data-aos="fade-up">
        <div class="col-12">
            <h1 class="display-4 text-premium">Add New Luxury Vehicle</h1>
        </div>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" id="createCarForm">
        <div class="row">
            <div class="col-md-8" data-aos="fade-right">
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0"><i class="bi bi-info-circle"></i> Basic Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Model" class="form-control" placeholder="Model Name">
                                    <label asp-for="Model">Model Name</label>
                                    <span asp-validation-for="Model" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ManufacturerId" class="form-select" asp-items="ViewBag.Manufacturers">
                                        <option value="">Select Manufacturer</option>
                                    </select>
                                    <label asp-for="ManufacturerId">Manufacturer</label>
                                </div>
                                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
                                <div class="mt-2" id="addManufacturerSection">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="showManufacturerInput()">
                                        <i class="bi bi-plus-circle"></i> New Manufacturer
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="TypeId" class="form-select" asp-items="ViewBag.CarTypes">
                                        <option value="">Select Type</option>
                                    </select>
                                    <label asp-for="TypeId">Vehicle Type</label>
                                    <span asp-validation-for="TypeId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="TransmissionId" class="form-select" asp-items="ViewBag.TransmissionTypes">
                                        <option value="">Select Transmission</option>
                                    </select>
                                    <label asp-for="TransmissionId">Transmission</label>
                                    <span asp-validation-for="TransmissionId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="card-header">
                        <h4 class="mb-0"><i class="bi bi-gear"></i> Technical Specifications</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Engine" class="form-control" placeholder="Engine">
                                    <label asp-for="Engine">Engine</label>
                                    <span asp-validation-for="Engine" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="BHP" class="form-control" placeholder="BHP">
                                    <label asp-for="BHP">BHP</label>
                                    <span asp-validation-for="BHP" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Mileage" class="form-control" placeholder="Mileage">
                                    <label asp-for="Mileage">Mileage</label>
                                    <span asp-validation-for="Mileage" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Price" class="form-control" placeholder="Price">
                                    <label asp-for="Price">Price</label>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="card-header">
                        <h4 class="mb-0"><i class="bi bi-shield-check"></i> Safety & Features</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea asp-for="AirBagDetails" class="form-control" style="height: 100px" placeholder="Air Bag Details"></textarea>
                                    <label asp-for="AirBagDetails">Air Bag Details</label>
                                    <span asp-validation-for="AirBagDetails" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea asp-for="Features" class="form-control" style="height: 100px" placeholder="Features"></textarea>
                                    <label asp-for="Features">Features</label>
                                    <span asp-validation-for="Features" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="sticky-top" style="top: 100px">
                    <div class="card mb-4" data-aos="fade-left">
                        <div class="card-header">
                            <h4 class="mb-0"><i class="bi bi-image"></i> Vehicle Image</h4>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <img id="photoPreview" src="/images/no-image.png" class="img-fluid rounded" style="max-height: 300px; width: auto;" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="PhotoFile" class="form-label">Choose Image</label>
                                <input asp-for="PhotoFile" class="form-control" accept="image/*" onchange="previewImage(this)" />
                                <span asp-validation-for="PhotoFile" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2" data-aos="fade-up">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Create Vehicle
                        </button>
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Quick Add Manufacturer Modal -->
<div class="modal fade" id="quickAddManufacturerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Manufacturer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="manufacturerName" placeholder="Manufacturer Name">
                    <label for="manufacturerName">Manufacturer Name</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveManufacturer()">Add Manufacturer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Check for error messages
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                toastr.error('@TempData["ErrorMessage"]');
            </text>
        }

        function showManufacturerInput() {
            var modal = new bootstrap.Modal(document.getElementById('quickAddManufacturerModal'));
            modal.show();
        }

        function saveManufacturer() {
            var name = document.getElementById('manufacturerName').value;
            if (!name) {
                toastr.error('Please enter a manufacturer name');
                return;
            }

            fetch('/Manufacturer/QuickAdd', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ name: name })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    var select = document.getElementById('ManufacturerId');
                    var option = new Option(name, data.id);
                    select.add(option);
                    select.value = data.id;
                    bootstrap.Modal.getInstance(document.getElementById('quickAddManufacturerModal')).hide();
                    document.getElementById('manufacturerName').value = '';
                    toastr.success('Manufacturer added successfully');
                } else {
                    toastr.error(data.message || 'Error adding manufacturer');
                }
            })
            .catch(error => {
                toastr.error('Error adding manufacturer');
            });
        }

        function previewImage(input) {
            var preview = document.getElementById('photoPreview');
            var file = input.files[0];
            var reader = new FileReader();

            reader.onloadend = function () {
                preview.src = reader.result;
                preview.classList.add('fade-in');
            }

            if (file) {
                reader.readAsDataURL(file);
            } else {
                preview.src = "/images/no-image.png";
            }
        }

        // Add floating label animation
        document.querySelectorAll('.form-floating input, .form-floating textarea').forEach(element => {
            element.addEventListener('focus', () => {
                element.parentElement.classList.add('focused');
            });
            element.addEventListener('blur', () => {
                if (!element.value) {
                    element.parentElement.classList.remove('focused');
                }
            });
        });
    </script>
}
