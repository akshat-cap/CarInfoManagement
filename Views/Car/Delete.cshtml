@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Delete Car";
}

<div class="container-fluid px-4 py-4">
    <div class="card glass">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h3 class="display-6 mb-1">Delete Confirmation</h3>
                    <p class="text-medium-emphasis mb-0">Are you sure you want to delete this car?</p>
                </div>
                <div class="badge bg-error px-3 py-2">
                    <i class="bi bi-exclamation-triangle me-2"></i>Warning
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card bg-surface-3 h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-4">Car Details</h5>
                            <div class="row g-4">
                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Model</dt>
                                        <dd class="mb-0 fs-5">@Model.Model</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Manufacturer</dt>
                                        <dd class="mb-0 fs-5">@(Model.Manufacturer?.Name ?? "Not specified")</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Type</dt>
                                        <dd class="mb-0">@(Model.CarType?.Type ?? "Not specified")</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Engine</dt>
                                        <dd class="mb-0">@Model.Engine</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">BHP</dt>
                                        <dd class="mb-0">@Model.BHP</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Transmission</dt>
                                        <dd class="mb-0">@(Model.TransmissionType?.Name ?? "Not specified")</dd>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="spec-card">
                                        <dt class="text-medium-emphasis mb-2">Price</dt>
                                        <dd class="mb-0 fs-5 text-primary">@Model.Price.ToString("C0")</dd>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card bg-surface-3 h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Car Image</h5>
                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <div class="position-relative overflow-hidden rounded">
                                    <img src="@Model.PhotoUrl" alt="@Model.Model" 
                                         class="img-fluid w-100" style="height: 300px; object-fit: cover;" />
                                    <div class="overlay-gradient"></div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-medium-emphasis">
                                    <i class="bi bi-image display-4"></i>
                                    <p class="mt-2">No image available</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-3 justify-content-center">
                <form asp-action="Delete" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg hover-lift">
                        <i class="bi bi-trash me-2"></i>Delete Car
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .spec-card {
        background: var(--dark-surface-2);
        border-radius: 12px;
        padding: 1.25rem;
        height: 100%;
    }
    
    .overlay-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.95), transparent);
    }
    
    .bg-error {
        background: var(--error-color);
    }
</style>