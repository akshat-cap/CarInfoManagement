@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Delete Car";
}

<div class="container-fluid px-4 py-4">
    <div class="card">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h3 class="mb-1">Delete Confirmation</h3>
                    <p class="text-medium-emphasis mb-0">Are you sure you want to delete this car?</p>
                </div>
                <div class="badge bg-error">
                    <i class="bi bi-exclamation-triangle me-2"></i>Warning
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card bg-surface-3">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Car Details</h5>
                            <dl class="row g-3">
                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Model</dt>
                                    <dd class="mb-0 fs-5">@Model.Model</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Manufacturer</dt>
                                    <dd class="mb-0 fs-5">@(Model.Manufacturer?.Name ?? "Not specified")</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Type</dt>
                                    <dd class="mb-0">@(Model.CarType?.Type ?? "Not specified")</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Engine</dt>
                                    <dd class="mb-0">@Model.Engine</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">BHP</dt>
                                    <dd class="mb-0">@Model.BHP</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Transmission</dt>
                                    <dd class="mb-0">@(Model.TransmissionType?.Name ?? "Not specified")</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Seats</dt>
                                    <dd class="mb-0">@Model.Seat</dd>
                                </div>

                                <div class="col-sm-6">
                                    <dt class="text-medium-emphasis">Price</dt>
                                    <dd class="mb-0 fs-5 text-primary">@Model.Price.ToString("C0")</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card bg-surface-3 h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Car Image</h5>
                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <img src="@Model.PhotoUrl" alt="@Model.Model" class="img-fluid rounded" style="width: 100%; height: 300px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="text-center py-5 text-medium-emphasis">
                                    <i class="bi bi-image display-4"></i>
                                    <p class="mt-2">No image available</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete Car
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>