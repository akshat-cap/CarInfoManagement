@model CarInfoManagementSystem.Models.Car

@{
    ViewData["Title"] = "Delete Car";
}

<h1>Delete Car</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this car?</h3>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Model)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Model)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Manufacturer.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Manufacturer.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CarType.Type)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CarType.Type)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Engine)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Engine)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BHP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.BHP)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TransmissionType.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TransmissionType.Name)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>